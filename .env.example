# ============================================================
#  IdleForge — variables d'environnement
#  Copie ce fichier en ".env.local" pour travailler sur ton PC,
#  et colle les mêmes valeurs dans Vercel (Settings > Environment Variables).
#  ⚠️ Ne mets JAMAIS ce fichier rempli sur GitHub : .env.local est ignoré par git.
#  Laisse une ligne vide => la fonction correspondante passe en mode démo.
# ============================================================

# Adresse publique du site (sans / à la fin). En local : http://localhost:3000
SITE_URL=http://localhost:3000

# Secret qui signe les cookies de connexion (32+ caractères aléatoires).
# Génère-le avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- IA : Google Gemini (offre gratuite) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Connexion Roblox (OAuth) — https://create.roblox.com/dashboard/credentials
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# --- Base de données : Supabase (offre gratuite) — https://supabase.com
# Project Settings > API : "Project URL" et la clé "service_role" (secrète !)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mettre "true" pour garder le bouton "Mode démo" même quand Roblox est configuré
ALLOW_DEMO=false

# Pièces (générations IA) offertes par jour et par créateur
FREE_DAILY_COINS=25
